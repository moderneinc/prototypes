{
  "color": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "#0F172A"
      },
      "terminal": {
        "$type": "color",
        "$value": "#020617"
      },
      "panel": {
        "$type": "color",
        "$value": "#334155"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#f8fafc"
      },
      "body": {
        "$type": "color",
        "$value": "#e2e8f0"
      },
      "supporting": {
        "$type": "color",
        "$value": "#94a3b8"
      },
      "metadata": {
        "$type": "color",
        "$value": "#64748b"
      }
    },
    "semantic": {
      "info": {
        "$type": "color",
        "$value": "#67e8f9"
      },
      "success": {
        "$type": "color",
        "$value": "#4ade80"
      },
      "danger": {
        "$type": "color",
        "$value": "#f87171"
      },
      "warning": {
        "$type": "color",
        "$value": "#fbbf24"
      }
    }
  },
  "typography": {
    "section_header": {
      "$type": "typography",
      "$value": {
        "weight": 700,
        "letterSpacing": "0.02em (mockup-only; terminals don't render letter-spacing — the casing carries the visual delta)",
        "color": "{color.text.primary (or color.semantic.danger when prefixed by ● in error sections — the bullet is colored, the header text remains primary white)}",
        "underline": false
      }
    },
    "primary": {
      "$type": "typography",
      "$value": {
        "weight": "regular (bold for banner phrases only)",
        "color": "{color.text.body}"
      }
    },
    "supporting": {
      "$type": "typography",
      "$value": {
        "weight": "regular",
        "color": "{color.text.supporting}"
      }
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "weight": "regular",
        "color": "{color.text.metadata}"
      }
    },
    "monospace": {
      "$type": "fontFamily",
      "$value": [
        "SF Mono",
        "Fira Code",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "spacing": {
    "indent": {
      "section_content": {
        "$type": "dimension",
        "$value": "16px"
      },
      "list_item_continuation": {
        "$type": "dimension",
        "$value": "32px"
      },
      "retired": {
        "$type": "dimension",
        "$value": "64px"
      }
    },
    "vertical": {
      "between_sections": {
        "$type": "dimension",
        "$value": "16px"
      },
      "header_to_content": {
        "$type": "dimension",
        "$value": "0px"
      },
      "around_close_banner": {
        "$type": "dimension",
        "$value": {
          "above": "16px",
          "below": "0px"
        }
      },
      "around_failure_preface": {
        "$type": "dimension",
        "$value": {
          "above": "0px",
          "below": "16px"
        }
      }
    }
  },
  "glyph": {
    "section_marker": {
      "$type": "string",
      "$value": "●"
    },
    "actionable_bullet": {
      "$type": "string",
      "$value": "▶"
    },
    "success_marker": {
      "$type": "string",
      "$value": "✓"
    },
    "warning_marker": {
      "$type": "string",
      "$value": "⚠"
    },
    "hint_marker": {
      "$type": "string",
      "$value": "?"
    },
    "note_marker": {
      "$type": "string",
      "$value": "!"
    },
    "child_connector": {
      "$type": "string",
      "$value": "└"
    },
    "shell_prompt": {
      "$type": "string",
      "$value": "$"
    },
    "diff_failure": {
      "$type": "string",
      "$value": "✗"
    }
  },
  "banner": {
    "close": {
      "success": {
        "$type": "object",
        "$value": {
          "phrase": "MOD SUCCEEDED",
          "color": "{color.semantic.success}"
        }
      },
      "partial_success": {
        "$type": "object",
        "$value": {
          "phrase": "MOD PARTIALLY SUCCEEDED",
          "color": "{color.semantic.warning}"
        }
      },
      "success_with_warnings": {
        "$type": "object",
        "$value": {
          "phrase": "MOD SUCCEEDED WITH WARNINGS",
          "color": "{color.semantic.warning}"
        }
      },
      "failure": {
        "$type": "object",
        "$value": {
          "phrase": "MOD FAILED",
          "color": "{color.semantic.danger}"
        }
      }
    }
  }
}
