{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Moderne Gradient Fields",
  "version": "2.0.0",
  "brandColors": {
    "digitalGreen": "#30F284",
    "deepGreen": "#1D5937",
    "ink": "#232342",
    "stone": "#F2F0EA",
    "night": "#100C0A"
  },
  "complementaryColors": {
    "magenta": { "bright": "#E6399B", "deep": "#7A1E52" },
    "violet": { "bright": "#9D5BE8", "deep": "#3F1340" },
    "blue": { "bright": "#3E7BF6", "deep": "#16306B" },
    "teal": { "bright": "#25D0C0", "deep": "#0E4A45" },
    "lime": { "bright": "#C7E84B", "deep": "#4F5A12" }
  },
  "atmosphericAccents": {
    "coral": "#FF6B5B",
    "yellow": "#FFD84D",
    "sky": "#7EDBFF",
    "paleCyan": "#D7F7F7"
  },
  "families": {
    "cool": {
      "colors": ["teal", "blue", "violet"],
      "character": ["technical", "dimensional"],
      "bestFor": ["product frames"],
      "cssClass": "mod-gradient--cool"
    },
    "warm": {
      "colors": ["blue", "coral", "magenta"],
      "character": ["energetic", "editorial"],
      "bestFor": ["DevCenter", "launches"],
      "cssClass": "mod-gradient--warm"
    },
    "genome": {
      "colors": ["magenta", "violet", "blue", "teal", "digitalGreen"],
      "character": ["expressive"],
      "bestFor": ["Code Genome"],
      "cssClass": "mod-gradient--genome"
    },
    "fresh": {
      "colors": ["lime", "teal", "blue"],
      "character": ["optimistic", "active"],
      "bestFor": ["agent stories", "product storytelling"],
      "cssClass": "mod-gradient--fresh"
    },
    "mist": {
      "colors": ["violet", "blue", "stone"],
      "character": ["quiet", "atmospheric"],
      "bestFor": ["UI backgrounds", "update artwork"],
      "cssClass": "mod-gradient--mist"
    }
  },
  "intensity": {
    "mist": { "visibleChroma": "5–15%", "bestFor": ["UI", "modals", "documentation"] },
    "atmosphere": { "visibleChroma": "15–40%", "bestFor": ["product frames", "default treatment"] },
    "expression": { "visibleChroma": "40–70%", "bestFor": ["campaigns", "social", "events"] },
    "fullExpression": { "visibleChroma": "70–100%", "bestFor": ["rare meaning-led moments", "Code Genome"] }
  },
  "anatomy": {
    "base": "50–70%",
    "primaryBloom": "20–40%",
    "secondaryBloom": "10–30%",
    "counterpoint": "0–15%"
  },
  "blur": {
    "focused": "15–25% of asset width",
    "soft": "30–50% of asset width",
    "atmospheric": "50–90% of asset width"
  }
}
