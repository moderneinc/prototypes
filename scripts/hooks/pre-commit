#!/bin/sh
# Pre-commit hook for Construct design system.
# 1. Validates new/modified pattern files against the template structure.
# 2. Auto-rebuilds the Figma plugin when design files change.

staged=$(git diff --cached --name-only)

# ── Validate pattern files ──────────────────────────────────────────────
# Any .md file in patterns/ or mirror/ must have the required sections.
# NEEDS PATTERN stubs (auto-generated by lint) are exempt.

pattern_files=$(echo "$staged" | grep -E '^design-system/(patterns|mirror)/.*\.md$')

if [ -n "$pattern_files" ]; then
  failed=0
  for file in $pattern_files; do
    # Skip deleted files
    if [ ! -f "$file" ]; then
      continue
    fi

    # Skip auto-generated NEEDS PATTERN stubs
    if grep -q "NEEDS PATTERN" "$file"; then
      continue
    fi

    missing=""

    # Check required sections
    if ! grep -q "^# Pattern" "$file"; then
      missing="$missing  missing: # Pattern — [Name] title\n"
    fi
    if ! grep -q "^## When this pattern applies" "$file"; then
      missing="$missing  missing: ## When this pattern applies\n"
    fi
    if ! grep -q "^## What the user sees" "$file"; then
      missing="$missing  missing: ## What the user sees\n"
    fi
    if ! grep -q '```' "$file"; then
      missing="$missing  missing: terminal preview code block\n"
    fi
    if ! grep -q "^## Composition rules" "$file"; then
      missing="$missing  missing: ## Composition rules\n"
    fi

    if [ -n "$missing" ]; then
      echo ""
      echo "✗ Pattern file missing required sections: $file"
      printf "$missing"
      echo "  See the template: design-system/pattern-template.md"
      echo ""
      failed=1
    fi
  done

  if [ "$failed" -eq 1 ]; then
    echo "Commit blocked. Fix the pattern files above, then try again."
    exit 1
  fi
fi

# ── Auto-rebuild Figma plugin ───────────────────────────────────────────

if echo "$staged" | grep -qE '^(design-system/|tokens/|lib/interpreters/figma-plugin/src/)'; then
  echo "◆ Design system files staged — rebuilding Figma plugin..."
  npm run figma-plugin:rebuild 2>&1

  # Add the rebuilt code.js to the commit
  git add lib/interpreters/figma-plugin/code.js
  echo "◆ code.js rebuilt and staged."
fi
